<IfModule mod_rewrite.c>
    RewriteEngine On

    # Direct access to public, admin, api, or existing files/directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Rewrite root request to public/
    RewriteRule ^$ public/ [L]

    # Rewrite all other requests to public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Block sensitive files from root
<FilesMatch "^\.(env|git|gitignore)">
    Order deny,allow
    Deny from all
</FilesMatch>

Options -Indexes
